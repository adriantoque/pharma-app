rules_version = '2';

// PharmaGuide keeps orders, sales and drafts under the signed-in user's own
// path, so for those the only question the rules answer is "is this your
// account". The medicine catalogue is the exception: it is one shared price
// list (`pharmacy/medicines/items`) that every signed-in account reads and
// writes. Nothing is readable without signing in.
//
// Deploy with:
//   firebase deploy --only firestore
//
// `firebase.json` points at this file (and at `firestore.indexes.json`), and
// `.firebaserc` pins the project, so the command above works from the repo root.
// Nothing runs it automatically: the rules are the one thing here that is not
// reviewable in a pull request and not testable by `flutter test`, so applying
// them stays a deliberate act at the console rather than something a build or a
// CI job does behind your back.
service cloud.firestore {
  match /databases/{database}/documents {

    // The profile document: `users/{uid}`. Firebase Auth answers who an account
    // is; this document is what says what it may do. The app reads it on every
    // sign-in to learn the role, and writes it during signup.
    //
    // Without this block the catch-all at the bottom denies the document, and
    // every consequence is silent: the sign-in falls back to `staff`, so an
    // administrator never reaches the admin shell; the `active` flag cannot be
    // read, so a deactivated account is never signed back out; and signup
    // creates the Auth account and then fails on the profile write, leaving an
    // address that is taken but has no profile.
    //
    // Read is open to any signed-in account rather than owner-only. The admin
    // Users screen lists every profile, and an owner-or-admin rule cannot be
    // used for a list query: a `get()` in a rule is capped at ten document
    // lookups per request, so a collection read of more than ten accounts would
    // fail outright. A profile carries a name, an email and a role -- the same
    // things colleagues already know about each other -- and nothing else.
    match /users/{userId} {
      allow read: if isSignedIn();

      // Signup writes its own profile, and may only pick a non-admin role:
      // otherwise the first thing a new account would do is promote itself. An
      // administrator creating an account for somebody else may assign any role.
      allow create: if (isOwner(userId) && validSelfProfile())
        || (isAdmin() && validProfile());

      // The owner may maintain their own name and email but not their role or
      // the active flag. Those two fields decide what the account can do, and
      // an account editing its own copy of them is privilege escalation.
      allow update: if (isOwner(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active)
        || isAdmin();

      allow delete: if isAdmin();
    }

    // The price list. Identified by a hash of the name and price rather than an
    // auto id, so re-importing the spreadsheet updates the existing lines and
    // leaves the stock counts in place.
    match /users/{userId}/medicines/{medicineId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validMedicine();
      allow delete: if isOwner(userId);
    }

    // The shared catalogue the app actually reads and writes
    // (`pharmacy/medicines/items`). One price list for every signed-in account,
    // rather than the per-user copy above, which is kept for accounts seeded
    // before the store moved. Without this block the catch-all below denies the
    // shared path and the catalogue silently stays on the bundled copy.
    match /pharmacy/medicines/items/{medicineId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && validMedicine();
      allow delete: if request.auth != null;
    }

    // The order being built up, as a single document rather than a collection:
    // a basket is one thing, and a collection would be another round trip per
    // line. Two segments of subcollection because a Firestore path has to be an
    // even number of segments deep, which is why this is not `users/{uid}/order`.
    match /users/{userId}/drafts/{draftId} {
      allow read, write: if isOwner(userId) && validDraft();
    }

    // Finished orders, newest first on `time`.
    match /users/{userId}/orders/{orderId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validOrder();
    }

    // Sales history, for the reports screen. Not yet written by the app; the
    // rules are here so the collection is not left open by accident when it is.
    match /users/{userId}/sales/{saleId} {
      allow read, write: if isOwner(userId) && validSale();
    }

    // The append-only administrator log: `audit`. Read by the Activity screen
    // and the dashboard's recent-activity list, written by the user-management
    // actions.
    //
    // Read is open to signed-in accounts for the same reason profiles are: the
    // screen streams up to 500 entries, and an admin-only rule would have to
    // `get()` the reader's profile once per document read, past the ten-lookup
    // cap. Creates are still administrator-only, and an entry is never edited
    // or deleted, which is what makes the log worth reading.
    match /audit/{eventId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && validAuditEvent();
      allow update, delete: if false;
    }

    // The store's own settings: `settings/store`, one singleton document.
    // Read by any signed-in account, because the staff-side screens read the
    // expiry window and the low-stock threshold out of it; written only by an
    // administrator, because the only editor is the admin workspace's Store
    // settings screen. The document carries no personal data and no prices,
    // so "signed-in may read" costs nothing an outsider does not already see
    // on the shelf.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && validStoreSettings();
      allow delete: if false;
    }

    // Everything else is closed. A document placed outside users/{uid} by
    // mistake is unreadable rather than quietly public.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // The shape of `settings/store`. Every field is bounded, because these are
  // the numbers the app's alert rules are computed from: a threshold typed as
  // a negative number would call every uncounted line low, and a window of
  // a million days would make the expiry list a lifetime commitment.
  function validStoreSettings() {
    let data = request.resource.data;
    return data.keys().hasAll(
        ['name', 'openMinutes', 'closeMinutes', 'lowStockThreshold',
         'expiryWarningDays'])
      && data.name is string
      && data.name.size() <= 80
      && (!data.keys().hasAny(['address']) || data.address is string)
      && (!data.keys().hasAny(['phone']) || data.phone is string)
      && data.openMinutes is int
      && data.openMinutes >= 0
      && data.openMinutes < 1440
      && data.closeMinutes is int
      && data.closeMinutes >= 0
      && data.closeMinutes < 1440
      && data.lowStockThreshold is int
      && data.lowStockThreshold >= 1
      && data.lowStockThreshold <= 99
      && data.expiryWarningDays is int
      && data.expiryWarningDays in [30, 60, 90]
      && data.reorderCoverageDays is int
      && data.reorderCoverageDays in [7, 14, 30]
      && (!data.keys().hasAny(['updatedBy']) || data.updatedBy is string);
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  // Whether the caller's own profile says `admin`.
  //
  // One document read, so it belongs on single-document writes only -- never on
  // a query, where the ten-lookup cap turns it into a rejection.
  //
  // The database segment is written out as `(default)` rather than
  // `$(database)`: interpolating the match wildcard resolves to null here, so
  // every lookup came back empty and every admin action was denied. `exists()`
  // guards the missing-profile case, and `data.get` guards a document written
  // before the role field did -- reading either directly turns a denial into a
  // rule error.
  function isAdmin() {
    return isSignedIn()
      && exists(/databases/(default)/documents/users/$(request.auth.uid))
      && get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
  }

  // A profile the account wrote for itself: no role above staff, and active.
  function validSelfProfile() {
    return validProfile()
      && request.resource.data.role in ['staff', 'guest']
      && request.resource.data.active == true;
  }

  // The shape of `users/{uid}`. Extra keys are allowed -- `createdAt` and
  // `updatedAt` are stamped by the writer -- but these four are required.
  function validProfile() {
    let data = request.resource.data;
    return data.keys().hasAll(['displayName', 'email', 'role', 'active'])
      && data.displayName is string
      && data.displayName.size() <= 80
      && data.email is string
      && data.email.size() <= 120
      && data.role in ['admin', 'staff', 'guest']
      && data.active is bool;
  }

  // One line the Activity screen can render, written by the account it names.
  function validAuditEvent() {
    let data = request.resource.data;
    return data.keys().hasAll(['action', 'actorUid', 'actorName', 'summary'])
      && data.action is string
      && data.actorUid == request.auth.uid
      && data.summary is string
      && data.summary.size() <= 200;
  }

  // A price-list line, checked field by field.
  //
  // The stock check is the one that matters: a negative or non-integer count
  // would render as a nonsense label, and `isOutOfStock` treats a negative
  // number as orderable. The expiry is a `yyyy-MM-dd` string or nothing, because
  // a shelf expiry is a date with no time of day.
  //
  // The descriptive fields are checked only when they are there: every line
  // carries them, but a line written before they existed does not, and a rule
  // that demanded them would lock the old documents out of being updated.
  function validMedicine() {
    let data = request.resource.data;
    return data.keys().hasAll(['name', 'priceCentavos', 'stock'])
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 60
      && data.priceCentavos is int
      && data.priceCentavos >= 0
      && (data.stock == null || (data.stock is int && data.stock >= 0))
      && (!data.keys().hasAny(['expiryDate'])
        || data.expiryDate == null
        || data.expiryDate is string)
      && (!data.keys().hasAny(['ageGroup'])
        || data.ageGroup in ['child', 'adult', 'both'])
      && (!data.keys().hasAny(['requiresRx'])
        || data.requiresRx is bool)
      && (!data.keys().hasAny(['category'])
        || data.category == null
        || data.category is string)
      && (!data.keys().hasAny(['dosageInfo'])
        || data.dosageInfo == null
        || data.dosageInfo is string);
  }

  // The basket being built up: `users/{uid}/drafts/order`.
  //
  // `lines` is allowed to be empty because clearing a basket is a write of no
  // lines, and that is the write the provider makes when a sale is completed or
  // the pharmacist presses clear.
  function validDraft() {
    let data = request.resource.data;
    return data.keys().hasAll(['lines', 'revision'])
      && validOrderLines(data.lines)
      && data.revision is int
      && data.revision >= 0;
  }

  // A finished order: `users/{uid}/orders/{orderId}`.
  //
  // Checked on the resulting document rather than the incoming patch, so
  // `updateStatus` -- which sends only `status` -- is judged against the whole
  // order it is changing rather than against a one-field map that could not pass
  // a completeness check.
  function validOrder() {
    let data = request.resource.data;
    return data.keys().hasAll(['time', 'status', 'lines', 'totalCentavos'])
      && data.time is timestamp
      && validStatus(data.status)
      && validOrderLines(data.lines)
      && data.totalCentavos is int
      && data.totalCentavos >= 0;
  }

  // 'rejected' must be allowed: OrdersProvider.updateOrderStatus writes it, and
  // a status the rules do not list makes rejecting an order fail at the rules
  // rather than reach the database.
  function validStatus(status) {
    return status in ['new', 'approved', 'rejected'];
  }

  // A basket as stored: a bounded list of lines.
  //
  // The per-line field checks are deliberately absent, and not by preference:
  // security rules cannot iterate a list. `lines.all(line, ...)` is not a rules
  // function at all -- it compiles with a warning and then fails at evaluation
  // with "Function not found: [all]", which turns every order and draft write
  // into a permission denial. What is left is the part a rule can actually
  // enforce: that `lines` is a list of at most 100 entries, so a document cannot
  // grow without bound.
  //
  // The shape of each line is the client codec's business. `OrderLineCodec`
  // writes exactly name, priceCentavos and quantity, and these documents are
  // owner-scoped: an account that writes a malformed line corrupts its own
  // order history and nobody else's.
  function validOrderLines(lines) {
    return lines is list
      && lines.size() <= 100;
  }

  // A sale line. The quantity is a number rather than an int because the
  // workbook has a couple of half-tablet lines, and rounding those up here
  // would put a number in the reports that the counter never sold.
  function validSale() {
    let data = request.resource.data;
    return data.keys().hasAll(['date', 'quantity', 'priceCentavos'])
      && data.date is string
      && data.quantity is number
      && data.quantity > 0
      && data.priceCentavos is int
      && data.priceCentavos >= 0;
  }
}
