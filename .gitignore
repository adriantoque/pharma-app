# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Unanchored on purpose: matches at any depth, so Gradle's android/build/ is
# covered alongside the Flutter output in ./build/.
build/
/coverage/
/flutter_temp/
*.dart.js
dart_sdk/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Firebase client configuration
#
# Regenerate per machine with `flutterfire configure`. These hold the project's
# API key and app ids; they are client identifiers rather than secrets, since
# access is governed by Firestore and Auth security rules, but they are per
# developer and per Firebase project so they stay out of the repository the
# same way the signing key in android/key.properties does.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Local debugging leftovers
scanlog.txt
flutter_01.png
